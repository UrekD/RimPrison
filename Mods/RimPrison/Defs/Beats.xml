      </li>
    </modExtensions>
  </IncidentDef>
  <RimPrison.PrisonDecisionDef><defName>RP_Decision_Truce</defName><label>gang truce</label><workerClass>RimPrison.TruceDecision</workerClass></RimPrison.PrisonDecisionDef>
