  </IncidentDef>
  <RimPrison.PrisonDecisionDef><defName>RP_Decision_FamilyDay</defName><label>family day</label><workerClass>RimPrison.FamilyDayDecision</workerClass><standingOrderAllowed>true</standingOrderAllowed></RimPrison.PrisonDecisionDef>
  <IncidentDef>
    <defName>RP_TooClose</defName>
    <label>officer too close to an inmate</label>
    <category>RP_StoryBeat</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>RimPrison.IncidentWorker_TooClose</workerClass>
    <baseChance>0.3</baseChance>
    <modExtensions>
      <li Class="RimPrison.StoryExt">
        <drama>1</drama>
        <weights></weights>
      </li>
    </modExtensions>
  </IncidentDef>
  <RimPrison.PrisonDecisionDef><defName>RP_Decision_TooClose</defName><label>officer too close</label><workerClass>RimPrison.TooCloseDecision</workerClass></RimPrison.PrisonDecisionDef>
  <ThoughtDef>
    <defName>RP_FamilyDay</defName>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>family day</label><description>My kids ran across the visiting room. For an afternoon I wasn't a number.</description><baseMoodEffect>10</baseMoodEffect></li></stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RP_FamilyDayCancelled</defName>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>no family day</label><description>Other prisons have family days. Ours said no.</description><baseMoodEffect>-3</baseMoodEffect></li></stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RP_SpecialAttention</defName>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>an officer looks out for me</label><description>One of the officers is on my side. That changes everything in here.</description><baseMoodEffect>6</baseMoodEffect></li></stages>
  </ThoughtDef>

  <!-- Pastimes and pressures: the big match, a talent show, gang initiation. -->
  <IncidentDef>
    <defName>RP_BigMatch</defName>
    <label>the big match</label>
    <category>RP_StoryBeat</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
