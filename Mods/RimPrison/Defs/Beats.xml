    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>RimPrison.IncidentWorker_RookieConned</workerClass>
    <baseChance>0.5</baseChance>
    <modExtensions>
      <li Class="RimPrison.StoryExt">
        <drama>1</drama>
        <weights></weights>
      </li>
    </modExtensions>
  </IncidentDef>
  <RimPrison.PrisonDecisionDef><defName>RP_Decision_Rookie</defName><label>rookie mistake</label><workerClass>RimPrison.RookieDecision</workerClass></RimPrison.PrisonDecisionDef>
  <IncidentDef>
    <defName>RP_Outbreak</defName>
    <label>flu outbreak</label>
    <category>RP_StoryBeat</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>RimPrison.IncidentWorker_Outbreak</workerClass>
    <baseChance>0.25</baseChance>
    <modExtensions>
      <li Class="RimPrison.StoryExt">
        <drama>2</drama>
        <weights><li><metric>Inmates</metric><curve><points><li>(6,0.5)</li><li>(20,1)</li><li>(60,1.5)</li></points></curve></li></weights>
      </li>
    </modExtensions>
  </IncidentDef>
  <RimPrison.PrisonDecisionDef><defName>RP_Decision_Outbreak</defName><label>flu outbreak</label><workerClass>RimPrison.OutbreakDecision</workerClass></RimPrison.PrisonDecisionDef>
  <ThoughtDef>
    <defName>RP_WrittenUp</defName>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>written up</label><description>My first week and already a mark on my file. I should have known better.</description><baseMoodEffect>-4</baseMoodEffect></li></stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RP_TruceHeld</defName>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>a truce on the wing</label><description>For once nobody's watching their back in the yard.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <!-- Innocence claims. -->
  <IncidentDef>
    <defName>RP_InnocenceClaim</defName>
    <label>innocence claim</label>
    <category>RP_StoryBeat</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>RimPrison.IncidentWorker_InnocenceClaim</workerClass>
    <baseChance>0.35</baseChance>
    <modExtensions>
      <li Class="RimPrison.StoryExt">
        <drama>1</drama>
        <perPawnCooldownDays>3</perPawnCooldownDays>
        <weights></weights>
      </li>
    </modExtensions>
  </IncidentDef>
  <RimPrison.PrisonDecisionDef><defName>RP_Decision_Innocence</defName><label>innocence claim</label><workerClass>RimPrison.InnocenceDecision</workerClass></RimPrison.PrisonDecisionDef>
  <ThoughtDef>
    <defName>RP_AppealDenied</defName>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>appeal denied</label><description>The court read it and said no. Back to the count.</description><baseMoodEffect>-6</baseMoodEffect></li></stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RP_BackedByWarden</defName>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>the warden believes me</label><description>Someone on the other side of the bars wrote to the court for me.</description><baseMoodEffect>6</baseMoodEffect></li></stages>
  </ThoughtDef>

  <!-- Announced inspections, the winter holiday. -->
  <RimPrison.PrisonDecisionDef><defName>RP_Decision_Inspection</defName><label>inspection notice</label><urgent>true</urgent><workerClass>RimPrison.InspectionDecision</workerClass></RimPrison.PrisonDecisionDef>
  <RimPrison.PrisonDecisionDef><defName>RP_Decision_Holiday</defName><label>winter holiday</label><workerClass>RimPrison.HolidayDecision</workerClass></RimPrison.PrisonDecisionDef>
  <ThoughtDef>
    <defName>RP_HolidayMeal</defName>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>holiday meal</label><description>Real turkey, a paper hat, and nobody started anything. For one day it almost felt normal.</description><baseMoodEffect>8</baseMoodEffect></li></stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RP_HolidayInside</defName>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>the holidays inside</label><description>Everyone out there is home with their family today. I'm counting bricks.</description><baseMoodEffect>-5</baseMoodEffect></li></stages>
  </ThoughtDef>

