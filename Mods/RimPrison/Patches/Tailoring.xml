<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- The workshop's tailor benches (vanilla's) are where the tailoring course is taught and where the tailors sew the prison's uniforms (Labor/Tailoring.cs). -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="HandTailoringBench"]/comps</xpath>
    <value>
      <li Class="RimPrison.CompProperties_Workstation">
        <uniforms>3</uniforms>
        <workTicks>2400</workTicks>
        <skill>Crafting</skill>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="ElectricTailoringBench"]/comps</xpath>
    <value>
      <li Class="RimPrison.CompProperties_Workstation">
        <uniforms>3</uniforms>
        <workTicks>1500</workTicks>
        <skill>Crafting</skill>
      </li>
    </value>
  </Operation>
</Patch>
